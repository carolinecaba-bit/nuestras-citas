# Puerto en el que corre el servidor
PORT=3000

# Open-Meteo es gratuito y NO requiere API Key para uso normal.
# Si tienes un plan comercial/de pago con Open-Meteo y una API Key propia,
# colocala aqui. El servidor la agregara automaticamente a las peticiones.
# Si la dejas vacia, la app funciona igual usando el servicio gratuito.
OPEN_METEO_API_KEY=

# URL base publica donde corre esta app (SIN slash final).
# Local:      http://localhost:3000
# En Render:  https://tu-servicio.onrender.com
# Se usa para construir la URL de retorno ("redirect URI") de Google.
APP_BASE_URL=http://localhost:3000

# Credenciales de "Iniciar sesion con Google" (ver README para como
# obtenerlas en Google Cloud Console). Sin estas dos, el boton de login
# muestra un mensaje claro en vez de fallar silenciosamente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clave para firmar la cookie de sesion. Cualquier texto largo y
# aleatorio sirve, por ejemplo generado con: openssl rand -hex 32
# Si la dejas vacia, el servidor genera una temporal al arrancar (pero
# las sesiones de todos se cierran cada vez que el servidor se reinicia).
SESSION_SECRET=
